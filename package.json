{
  "name": "ingenia-xeokit-runtime",
  "version": "0.2.0-dev",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@xeokit/xeokit-convert": "1.3.2"
  },
  "overrides": {
    "request": {
      "form-data": "2.5.6",
      "qs": "6.15.3",
      "tough-cookie": "4.1.4"
    }
  },
  "workspaces": [
    "packages/converter",
    "packages/protocol",
    "packages/viewer"
  ],
  "scripts": {
    "build": "npm run build -w @ingenia/xeokit-viewer",
    "converter:prepare": "npm run prepare:runtime -w @ingenia/xeokit-converter",
    "converter:smoke": "node scripts/verify-converter-smoke.mjs",
    "converter:version": "npm run version:check -w @ingenia/xeokit-converter",
    "dev": "npm run dev -w @ingenia/xeokit-viewer",
    "sbom:generate": "node scripts/generate-release-sbom.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "test": "node --test tests/contract/*.test.mjs tests/security/*.test.mjs tests/publication/*.test.mjs",
    "validate:publication": "node scripts/validate-publication.mjs",
    "verify:image": "node scripts/verify-running-image.mjs",
    "verify:xkt-smoke": "node scripts/verify-xkt-smoke-output.mjs"
  }
}
